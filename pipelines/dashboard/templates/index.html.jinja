<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pokémon Champions — Analytics Dashboard</title>
<style>
  /* ---------------------------------------------------------------
   * Design tokens — see docs/design-system.md for the full token
   * reference, component catalog, and Pokémon-representation/naming
   * conventions this dashboard follows. Every color, spacing, and
   * radius value used below traces back to one of these variables so
   * the two stay in sync.
   * --------------------------------------------------------------- */
  :root {
    /* Color */
    --navy: #16264d;
    --blue: #2b5cad;
    --light-blue: #eaf1fb;
    --border: #16264d;
    --muted: #5b6b8c;
    --bg: #f4f6fb;
    --surface: #fff;
    --positive: #1f8a4c;
    --positive-bg: #e8f7ee;
    --warning: #a8710a;
    --warning-bg: #fbf1e0;
    --danger: #b23434;
    --danger-bg: #fbe9e9;

    /* Broadcast/esports theme tokens (docs/design-system.md's "Broadcast
       color-block header" component) — color-blocking + weight/case is
       what gives this a broadcast-graphic feel, deliberately without
       adding a webfont dependency. */
    --panel-dark: #12131a;
    --accent-red: #e3323c;
    --accent-red-bg: #fce7e8;
    --accent-gold: #f4b942;
    --accent-gold-bg: #fdf3dd;

    /* Icon-size scale (docs/design-system.md's "Icon size scale") — every
       sprite/item/type icon must use one of these three tokens, no other
       pixel value, replacing four previously ad-hoc sizes (40/32/24/22px).
       --icon-xl is a deliberate 4th tier, reserved for the Pokémon Profile
       header's dual-type badge (a new, hero-level piece of information —
       see "Larger type badge" in docs/design-system.md). */
    --icon-sm: 40px;
    --icon-md: 64px;
    --icon-lg: 96px;
    --icon-xl: 128px;

    /* Speed-tier badge scale (docs/design-system.md's "Speed-tier badge"
       component) — bucketed off pokemon_champions_profile.speed. */
    --speed-blazing: #b23434;
    --speed-blazing-bg: #fbe9e9;
    --speed-fast: #a8710a;
    --speed-fast-bg: #fbf1e0;
    --speed-average: #2b5cad;
    --speed-average-bg: #eaf1fb;
    --speed-slow: #5b6b8c;
    --speed-slow-bg: #eef0f5;

    /* Spacing scale (4px base unit) */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;

    /* Radius scale */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-pill: 999px;

    /* Type scale */
    --font-xs: 0.8rem;
    --font-sm: 0.85rem;
    --font-base: 0.9rem;
    --font-md: 0.95rem;
    --font-lg: 1.1rem;
    --font-xl: 1.5rem;
    --font-2xl: 1.6rem;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--navy);
  }
  header {
    background: var(--panel-dark);
    color: #fff;
    padding: 24px;
    text-align: center;
  }
  header h1 {
    margin: 0;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }
  header p { margin: 4px 0 0; color: #b8bdd1; font-size: 0.9rem; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px; }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .kpi-card {
    background: #fff;
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .kpi-card .kpi-sprite { width: var(--icon-lg); height: var(--icon-lg); object-fit: contain; flex: 0 0 auto; }
  .kpi-card .kpi-body { min-width: 0; }
  .kpi-card .label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  .kpi-card .value { font-size: 1.5rem; font-weight: 700; margin-top: 4px; overflow-wrap: break-word; }
  .kpi-card .sub { font-size: 0.85rem; color: var(--muted); margin-top: 2px; }

  /* --- Tabs --- */
  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-bottom: 2px solid var(--border);
    margin-bottom: 20px;
  }
  .tab-btn {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 10px 16px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--navy); }
  .tab-btn[aria-selected="true"] {
    color: var(--accent-red);
    border-bottom-color: var(--accent-red);
  }
  .tab-panel[hidden] { display: none; }

  /* --- Sub-tabs: a compact pill row nested inside one top-level tab/
     section (e.g. Usage's leaderboards, Pokémon Profile's Items/Ability/
     Moves/Team Cores), so several equally-important views can share one
     section instead of stacking. Deliberately visually lighter than the
     top-level `.tabs` row above, which stays reserved for the page's
     seven main tabs. --- */
  .subtabs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .subtab-btn {
    flex: 0 0 auto;
    background: var(--light-blue);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .subtab-btn:hover { color: var(--navy); }
  .subtab-btn[aria-selected="true"] { background: var(--blue); color: #fff; }
  .subtab-panel[hidden] { display: none; }

  section {
    background: #fff;
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 0 var(--space-8) var(--space-8);
    margin-bottom: var(--space-6);
    overflow: hidden;
  }
  /* Broadcast color-block section header (docs/design-system.md) — bold,
     uppercase, letter-spaced, on a dark bar, replacing plain
     text-on-white section titles. */
  section h2 {
    margin: 0 calc(var(--space-8) * -1) var(--space-4);
    padding: var(--space-4) var(--space-8);
    background: var(--panel-dark);
    color: #fff;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }
  section h3 { font-size: var(--font-md); text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  .controls { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; align-items: flex-end; }
  .controls label { font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  select {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
  }
  /* Range filter (min/max pair — stat-range, usage/win-rate range) */
  .range-filter { display: flex; align-items: center; gap: 4px; }
  .range-filter input[type="number"] {
    width: 4.5em;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px;
  }
  .type-filter-row { display: flex; flex-wrap: wrap; gap: 4px; max-width: 320px; }

  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--light-blue); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--navy); }
  th.sortable .sort-indicator { margin-left: 4px; color: var(--accent-red); }

  /* Sprite/icon cells populated by app.js's pokemonCell()/iconCell() helpers */
  .cell-with-icon { display: flex; align-items: center; gap: 8px; }
  .cell-icon { width: var(--icon-sm); height: var(--icon-sm); object-fit: contain; flex: 0 0 auto; }

  /* Small muted annotation next to a value (Win rate leaders table's
     "(n=X)" sample-size note — see "Percentages, not raw counts" in
     docs/design-system.md). */
  .ranked-value { color: var(--muted); font-weight: 700; white-space: nowrap; }

  /* --- 6-wide grid (docs/design-system.md's "3-tier tab layout
     convention" tier 2, and the ".grid-6xn component"): the dashboard's
     one component for any usage/win-rate metric and for a spotlight
     grid of Pokémon (Overview's Top 12), replacing the old ranked-list
     bars and the separate spotlight-grid/spotlight-card pattern. Fixed 6
     columns on desktop (not auto-fill/auto-fit — a deliberately denser,
     more uniform grid), collapsing to 3 columns at 720px and 2 at 480px
     per the existing breakpoint convention. Each tile bolds its headline
     percentage (.grid-6xn-value) per the "bold the percentage" ask. */
  .grid-6xn { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-3); }
  .grid-6xn-tile {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-1);
    position: relative;
  }
  .grid-6xn-tile.is-leader { border-color: var(--accent-red); background: var(--accent-red-bg); }
  /* Normal flow, left-aligned within the centered column — not absolutely
     positioned, so it reserves its own row instead of overlapping the
     label when a tile has no icon (e.g. an item/ability/move/team with no
     resolvable sprite). */
  .grid-6xn-tile .badge-rank { align-self: flex-start; }
  .grid-6xn-tile img { width: var(--icon-md); height: var(--icon-md); object-fit: contain; }
  .grid-6xn-tile .grid-6xn-label { font-weight: 600; font-size: var(--font-xs); overflow-wrap: anywhere; }
  .grid-6xn-value { font-weight: 800; font-size: var(--font-lg); color: var(--navy); }
  .grid-6xn-tile.is-leader .grid-6xn-value { color: var(--accent-red); }
  .grid-6xn-sub { font-size: var(--font-xs); color: var(--muted); }

  /* --- Pro Team Gallery card grid --- */
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4); }
  .gallery-card { border: 2px solid var(--border); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; }
  .gallery-card img.gallery-card-image { width: 100%; display: block; }
  .gallery-card .gallery-card-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); }
  .gallery-card .gallery-card-player { font-weight: 700; }
  .gallery-card .gallery-card-meta { font-size: var(--font-xs); color: var(--muted); }

  .empty-state {
    background: var(--light-blue);
    border-radius: 8px;
    padding: 14px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* --- Badge (rank pills, speed tiers — see docs/design-system.md) --- */
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--font-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-rank { background: var(--light-blue); color: var(--blue); }
  .badge-speed-blazing { background: var(--speed-blazing-bg); color: var(--speed-blazing); }
  .badge-speed-fast { background: var(--speed-fast-bg); color: var(--speed-fast); }
  .badge-speed-average { background: var(--speed-average-bg); color: var(--speed-average); }
  .badge-speed-slow { background: var(--speed-slow-bg); color: var(--speed-slow); }

  /* --- Type badge (Pokémon Profile header, Matchup tab pickers) — the
     dashboard's first-ever Pokémon-type display (pokemon.type_1/type_2,
     PokéAPI). Icon-only emblems (no visible text label) — the type name
     is exposed via the pill's aria-label/the icon's title attribute
     instead, so it stays accessible without cluttering the badge. Uses
     --icon-xl for hero-level prominence, the one documented exception to
     the 3-tier icon scale. --- */
  .type-badge-row { display: flex; align-items: center; gap: var(--space-2); }
  .type-pill { display: inline-flex; align-items: center; justify-content: center; }

  /* Profile header's dual-type display — the one place a type icon uses
     --icon-xl instead of the sm/md/lg scale (see "Icon size scale" above). */
  .type-badge-row.type-badge-lg { gap: var(--space-3); }
  .type-badge-lg .type-pill-lg { display: inline-flex; align-items: center; justify-content: center; }

  /* Crops static/icons/types/*.png (wide 200x40 "icon + type name" badges,
     not bare square icons) down to just the icon's fixed-width left
     square, so every type-icon use (compact pills, the large Profile
     badge, the Matchup effectiveness grid, filter chips) shows a real
     icon-only emblem instead of a squished text badge — see
     typeIconImg() in app.js. */
  .type-icon-crop { display: inline-block; overflow: hidden; border-radius: var(--radius-sm); vertical-align: -3px; }
  .type-icon-crop img { display: block; }

  /* --- Descriptive sub-text under a name (Pokémon Profile's Items/
     Ability/Moves sections; Matchup panel move picker) --- */
  .desc-text { font-size: var(--font-xs); color: var(--muted); margin-top: 2px; }

  /* --- Matchup tab: type-effectiveness grid + damage calculator --- */
  .type-effect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: var(--space-2); }
  .type-effect-tile {
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    text-align: center;
    font-size: var(--font-xs);
    font-weight: 700;
    text-transform: uppercase;
  }
  .type-effect-4x { background: #1f8a4c; color: #fff; }
  .type-effect-2x { background: #bfe3cd; color: #1f8a4c; }
  .type-effect-1x { background: var(--light-blue); color: var(--muted); }
  .type-effect-half { background: #fbe3c9; color: var(--warning); }
  .type-effect-quarter { background: var(--danger-bg); color: var(--danger); }
  .type-effect-0x { background: var(--navy); color: #fff; }

  .matchup-picker-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .matchup-side { border: 1px solid var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); }
  .matchup-side h4 { margin: 0 0 var(--space-2); }
  .stage-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-1); }
  .stage-row label { font-size: var(--font-xs); color: var(--muted); flex: 0 0 60px; }
  .stage-row input[type="range"] { flex: 1 1 auto; }
  .stage-row .stage-value { width: 2.2em; text-align: right; font-weight: 700; font-size: var(--font-xs); }

  .damage-result { background: var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); margin-top: var(--space-4); text-align: center; }
  .damage-result .damage-range { font-size: var(--font-2xl); font-weight: 800; color: var(--navy); }
  .damage-result .damage-sub { font-size: var(--font-sm); color: var(--muted); margin-top: var(--space-1); }
  .toggle-chip-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .toggle-chip {
    font-size: var(--font-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }
  .toggle-chip[aria-pressed="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }

  /* --- Top Teams tab: leaderboard tiles + pokepaste import/export --- */
  .pokepaste-box { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); }
  .pokepaste-box textarea {
    width: 100%;
    min-height: 140px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--font-sm);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    resize: vertical;
  }
  .pokepaste-actions { display: flex; gap: var(--space-2); align-items: center; }
  .pokepaste-status { font-size: var(--font-xs); color: var(--muted); }

  /* --- Buttons --- */
  .btn {
    font: inherit;
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--navy);
    cursor: pointer;
  }
  .btn:hover { background: var(--light-blue); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
  .btn-primary:hover { background: var(--navy); }
  .btn-primary:disabled { background: var(--muted); border-color: var(--muted); }
  .btn-remove {
    background: none;
    border: none;
    color: var(--danger);
    font-size: var(--font-md);
    cursor: pointer;
    line-height: 1;
    padding: 2px 6px;
  }
  .btn-remove:hover { text-decoration: underline; }
  .btn-sm { padding: 4px 10px; font-size: var(--font-xs); }

  input[type="text"] {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
    width: 100%;
  }

  /* --- Team Builder --- */
  .team-builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .roster-picker { display: flex; flex-direction: column; gap: var(--space-3); }
  .roster-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid var(--light-blue);
    border-radius: var(--radius-sm);
  }
  .roster-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--light-blue);
  }
  .roster-item:last-child { border-bottom: none; }
  .roster-item .roster-info { flex: 1 1 auto; min-width: 0; }
  .roster-item .roster-name { font-weight: 600; }
  .roster-item .roster-sub { font-size: var(--font-xs); color: var(--muted); }

  .team-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .team-slot {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
    min-height: 96px;
    justify-content: center;
  }
  .team-slot.empty { border-style: dashed; color: var(--muted); font-size: var(--font-xs); }
  .team-slot img { width: var(--icon-lg); height: var(--icon-lg); object-fit: contain; }
  .team-slot .slot-name { font-weight: 600; font-size: var(--font-sm); }
  .team-slot .slot-detail { font-size: var(--font-xs); color: var(--muted); }
  .team-slot select { width: 100%; margin-top: 2px; }
  .team-slot .slot-move-selects { display: flex; flex-direction: column; gap: 2px; width: 100%; }

  .speed-order-list { list-style: none; margin: 0; padding: 0; }
  .speed-order-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
  }
  .speed-order-list .speed-value { margin-left: auto; font-weight: 600; }

  .stat-summary-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .stat-summary-row .stat {
    background: var(--light-blue);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-sm);
  }
  .stat-summary-row .stat strong { display: block; font-size: var(--font-lg); color: var(--navy); }

  @media (max-width: 720px) {
    .team-builder-grid { grid-template-columns: 1fr; }
    .team-slots { grid-template-columns: repeat(2, 1fr); }
    .grid-6xn { grid-template-columns: repeat(3, 1fr); }
    .matchup-picker-grid { grid-template-columns: 1fr; }
  }

  footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px; }

  @media (max-width: 720px) {
    main { padding: 16px; }
    .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .kpi-card { padding: 12px; }
    .kpi-card .value { font-size: 1.2rem; }
  }

  @media (max-width: 480px) {
    header h1 { font-size: 1.3rem; }
    .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .kpi-card { flex-direction: column; align-items: flex-start; gap: 6px; }
    .controls select { width: 100%; }
    section { padding: var(--space-4); }
    section h2 { margin: 0 calc(var(--space-4) * -1) var(--space-4); padding: var(--space-3) var(--space-4); }
    .grid-6xn { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 360px) {
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<header>
  <h1>Pokémon Champions — Analytics Dashboard</h1>
  <p>Generated {{ payload.kpis.latest_snapshot_date or "—" }} · built {{ payload.generated_at_utc }}</p>
</header>
<main>
  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-body">
        <div class="label">Distinct Pokémon Used</div>
        <div class="value">{{ payload.kpis.distinct_pokemon_used }}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_used = payload.kpis.top_used_pokemon %}
      {% if top_used and payload.sprites.get(top_used.pokemon_key) %}
        <img class="kpi-sprite" src="{{ payload.sprites[top_used.pokemon_key] }}" alt="">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Most Used</div>
        <div class="value">{% if top_used %}{{ top_used.pokemon_name }}{% else %}—{% endif %}</div>
        <div class="sub">{% if top_used %}{{ top_used.usage_count }} roster appearances{% if top_used.usage_share is not none %} ({{ "%.1f"|format(top_used.usage_share * 100) }}% of meta){% endif %}{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_win = payload.kpis.top_win_rate_pokemon %}
      {% if top_win and payload.sprites.get(top_win.pokemon_key) %}
        <img class="kpi-sprite" src="{{ payload.sprites[top_win.pokemon_key] }}" alt="">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Top Win Rate</div>
        <div class="value">{% if top_win %}{{ top_win.pokemon_name }}{% else %}—{% endif %}</div>
        <div class="sub">{% if top_win %}{{ "%.1f"|format(top_win.win_rate * 100) }}% ({{ top_win.record_count }} recorded matches){% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-body">
        <div class="label">Legal Pool (cumulative)</div>
        <div class="value">
          {% for r in payload.kpis.legal_pool_by_regulation %}{{ r.regulation_code }}: {{ r.cumulative_legal_pokemon_count }}{% if not loop.last %} · {% endif %}{% endfor %}
          {% if not payload.kpis.legal_pool_by_regulation %}—{% endif %}
        </div>
        <div class="sub">as of {{ payload.kpis.latest_snapshot_date or "—" }}</div>
      </div>
    </div>
  </div>

  <nav class="tabs" role="tablist">
    <button class="tab-btn" role="tab" data-tab="overview" aria-selected="true">Overview</button>
    <button class="tab-btn" role="tab" data-tab="usage" aria-selected="false">Usage</button>
    <button class="tab-btn" role="tab" data-tab="pokemon-profile" aria-selected="false">Pokémon Profile</button>
    <button class="tab-btn" role="tab" data-tab="speed-tiers" aria-selected="false">Speed Tiers</button>
    <button class="tab-btn" role="tab" data-tab="matchup" aria-selected="false">Matchup</button>
    <button class="tab-btn" role="tab" data-tab="team-builder" aria-selected="false">Team Builder</button>
    <button class="tab-btn" role="tab" data-tab="top-teams" aria-selected="false">Top Teams</button>
  </nav>

  <section class="tab-panel" data-panel="overview">
    <h2>Overview</h2>
    <p class="sub">Top 12 most-used Pokémon this dataset version, ranked by share of the meta.</p>
    <div class="grid-6xn" id="overview-top-12"></div>
  </section>

  <section class="tab-panel" data-panel="usage" hidden>
    <h2>Usage</h2>
    <p class="sub">Real Pokémon Champions tournament data (MunchStats) — every usage and win-rate figure below is computed from actual recorded rosters, not a blend with other sources.</p>
    <div class="controls">
      <label>Tier
        <select id="usage-tier-filter"></select>
      </label>
      <label>Type
        <div class="type-filter-row" id="usage-type-filter"></div>
      </label>
      <label>Role
        <select id="usage-role-filter">
          <option value="">All roles</option>
          <option value="physical">Physical</option>
          <option value="special">Special</option>
          <option value="mixed">Mixed</option>
        </select>
      </label>
      <label>Usage %
        <div class="range-filter">
          <input type="number" id="usage-share-min" min="0" max="100" placeholder="min">
          <span>–</span>
          <input type="number" id="usage-share-max" min="0" max="100" placeholder="max">
        </div>
      </label>
      <label>Speed
        <div class="range-filter">
          <input type="number" id="usage-speed-min" min="0" placeholder="min">
          <span>–</span>
          <input type="number" id="usage-speed-max" min="0" placeholder="max">
        </div>
      </label>
    </div>
    <div class="grid-6xn" id="usage-grid"></div>

    <h3>Leaderboards</h3>
    <div class="subtabs" role="tablist">
      <button class="subtab-btn" role="tab" data-subtab="usage-leaders" aria-selected="true">Usage leaders</button>
      <button class="subtab-btn" role="tab" data-subtab="win-rate-leaders" aria-selected="false">Win rate leaders</button>
    </div>

    <div class="subtab-panel" data-subpanel="usage-leaders">
      <p class="sub">Ranked by % of meta within the selected tier and filters. Click a column header to re-sort.</p>
      <div class="table-scroll">
        <table id="usage-leaders-table">
          <thead><tr><th>Rank</th><th>Pokémon</th><th class="sortable" data-sort-key="usage_share">% of meta</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="subtab-panel" data-subpanel="win-rate-leaders" hidden>
      <div class="controls">
        <label>Min. recorded matches
          <select id="win-rate-min-record-count-filter">
            <option value="5">5+</option>
            <option value="10">10+</option>
            <option value="20">20+</option>
            <option value="50">50+</option>
          </select>
        </label>
      </div>
      <div class="grid-6xn" id="win-rate-grid"></div>
      <div class="table-scroll">
        <table id="win-rate-table">
          <thead><tr><th>Rank</th><th>Pokémon</th><th class="sortable" data-sort-key="win_rate">Win rate</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="tab-panel" data-panel="pokemon-profile" hidden>
    <h2>Pokémon Profile</h2>
    <div class="controls">
      <label>Pokémon
        <select id="pokemon-profile-filter"></select>
      </label>
    </div>

    <div id="pokemon-profile-stats" class="empty-state"></div>

    <div class="subtabs" role="tablist">
      <button class="subtab-btn" role="tab" data-subtab="profile-items" aria-selected="true">Items</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-ability">Ability</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-moves">Moves</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-team-cores">Team Cores</button>
    </div>

    <div class="subtab-panel" data-subpanel="profile-items">
      <p class="sub">Top 5 recorded held items.</p>
      <div class="grid-6xn" id="profile-item-grid"></div>
    </div>

    <div class="subtab-panel" data-subpanel="profile-ability" hidden>
      <p class="sub">Top 5 recorded abilities.</p>
      <div class="grid-6xn" id="profile-ability-grid"></div>
    </div>

    <div class="subtab-panel" data-subpanel="profile-moves" hidden>
      <p class="sub">Top 15 recorded moves, with full mechanics.</p>
      <div class="table-scroll">
        <table id="profile-move-table">
          <thead>
            <tr>
              <th>Move</th>
              <th class="sortable" data-sort-key="move_share">Usage</th>
              <th>Category</th>
              <th class="sortable" data-sort-key="power">Power</th>
              <th class="sortable" data-sort-key="accuracy">Accuracy</th>
              <th class="sortable" data-sort-key="pp">PP</th>
              <th class="sortable" data-sort-key="priority">Priority</th>
              <th>Effect</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="subtab-panel" data-subpanel="profile-team-cores" hidden>
      <p class="sub">Which Pokémon most often share a team with this Pokémon.</p>
      <div class="grid-6xn" id="profile-team-core-grid"></div>
    </div>
  </section>

  <section class="tab-panel" data-panel="speed-tiers" hidden>
    <h2>Speed tiers</h2>
    <p class="sub">
      Every currently-legal Pokémon's Champions-format base Speed stat,
      fastest first, bucketed into the speed-tier bands documented in
      docs/design-system.md.
    </p>
    <div class="controls">
      <label>Speed
        <div class="range-filter">
          <input type="number" id="speed-tiers-min" min="0" placeholder="min">
          <span>–</span>
          <input type="number" id="speed-tiers-max" min="0" placeholder="max">
        </div>
      </label>
      <label>Type
        <div class="type-filter-row" id="speed-tiers-type-filter"></div>
      </label>
    </div>
    <div class="grid-6xn" id="speed-grid"></div>
    <div class="table-scroll">
      <table id="speed-tiers-table">
        <thead>
          <tr>
            <th>Rank</th><th>Pokémon</th>
            <th class="sortable" data-sort-key="speed">Speed</th>
            <th>Tier</th>
            <th class="sortable" data-sort-key="usage_share">Usage</th>
            <th class="sortable" data-sort-key="win_rate">Win rate</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="tab-panel" data-panel="matchup" hidden>
    <h2>Matchup</h2>
    <p class="sub">
      Type effectiveness, teammate co-usage, and a stats/setup/weather-aware
      damage calculator — see docs/design-system.md's "Matchup tab" for what
      this does and doesn't model (no per-battle head-to-head outcome data
      exists in this dataset; co-usage is a teammate-pairing proxy, not a
      real matchup-outcome signal).
    </p>
    <div class="matchup-picker-grid">
      <div class="matchup-side">
        <h4>Attacker</h4>
        <label>Pokémon <select id="matchup-attacker-select"></select></label>
        <div id="matchup-attacker-type" class="type-badge-row"></div>
        <div id="matchup-attacker-stats" class="desc-text"></div>
        <label>Move <select id="matchup-move-select"></select></label>
        <div id="matchup-move-desc" class="desc-text"></div>
        <h4>Setup</h4>
        <div id="matchup-attacker-stages"></div>
      </div>
      <div class="matchup-side">
        <h4>Defender</h4>
        <label>Pokémon <select id="matchup-defender-select"></select></label>
        <div id="matchup-defender-type" class="type-badge-row"></div>
        <div id="matchup-defender-stats" class="desc-text"></div>
        <h4>Setup</h4>
        <div id="matchup-defender-stages"></div>
      </div>
    </div>
    <div class="controls">
      <label>Weather
        <select id="matchup-weather">
          <option value="">None</option>
          <option value="rain">Rain</option>
          <option value="sun">Harsh Sunlight</option>
          <option value="sand">Sandstorm</option>
          <option value="snow">Snow</option>
        </select>
      </label>
    </div>
    <div class="toggle-chip-row" id="matchup-toggle-row"></div>
    <div class="damage-result" id="matchup-damage-result"></div>

    <h3>Type effectiveness</h3>
    <p class="sub">The attacker's type(s) against the defender's type(s).</p>
    <div class="type-effect-grid" id="matchup-type-grid"></div>

    <h3>Co-usage</h3>
    <p class="sub">Pokémon most often teamed with the defender in real tournament rosters (a teammate-pairing proxy, not a battle-outcome signal).</p>
    <div class="grid-6xn" id="matchup-co-usage-grid"></div>
  </section>

  <section class="tab-panel" data-panel="team-builder" hidden>
    <h2>Team builder</h2>
    <p class="sub">
      Build a roster of up to 6 from the current legal pool, with each
      pick's stats, top move, and top ability shown right on its slot. Your
      team is saved in this browser (not shared or uploaded anywhere).
    </p>
    <div class="team-builder-grid">
      <div class="roster-picker">
        <h3>Legal pool</h3>
        <div class="controls">
          <label>Search
            <input type="text" id="team-builder-search" placeholder="Filter by name…">
          </label>
          <label>Sort by
            <select id="team-builder-sort">
              <option value="usage">Usage</option>
              <option value="win_rate">Win rate</option>
              <option value="speed">Speed</option>
            </select>
          </label>
          <label>Type
            <div class="type-filter-row" id="team-builder-type-filter"></div>
          </label>
        </div>
        <ul class="roster-list" id="team-builder-available"></ul>
      </div>
      <div class="team-roster">
        <h3>Your team (<span id="team-builder-count">0</span>/6)</h3>
        <div class="team-slots" id="team-builder-slots"></div>
        <div class="pokepaste-actions">
          <button class="btn btn-sm" id="team-builder-clear" type="button">Clear team</button>
          <button class="btn btn-sm" id="team-builder-export" type="button">Export as pokepaste text</button>
        </div>
        <textarea id="team-builder-export-output" class="pokepaste-box" style="display:none" readonly></textarea>

        <h3>Speed order</h3>
        <p class="sub">Your team's picks, fastest first — who moves before whom.</p>
        <ol class="speed-order-list" id="team-builder-speed-order"></ol>

        <div class="stat-summary-row" id="team-builder-summary"></div>
      </div>
    </div>
  </section>

  <section class="tab-panel" data-panel="top-teams" hidden>
    <h2>Import a team</h2>
    <p class="sub">
      Paste a Showdown/pokepast.es-format team export below (the same text
      you'd paste to create a pokepast.es paste) to load it into Team
      Builder. Nothing is uploaded — parsing happens in your browser.
    </p>
    <div class="pokepaste-box">
      <textarea id="pokepaste-input" placeholder="Paste a Showdown-format team export here…"></textarea>
      <div class="pokepaste-actions">
        <button class="btn btn-primary btn-sm" id="pokepaste-load" type="button">Load into Team Builder</button>
        <span class="pokepaste-status" id="pokepaste-status"></span>
      </div>
    </div>

    <h2>Top Teams</h2>
    <p class="sub">Real Pokémon Champions tournament teams (MunchStats), ranked by reported win rate — distinct from the curated Pro Team Gallery below.</p>
    <div class="grid-6xn" id="top-teams-grid"></div>

    <h3>Pro Team Gallery</h3>
    <p class="sub">
      Curated real tournament teams for reference/inspiration — not part of
      your saved roster. "Load into my builder" copies a gallery team's
      Pokémon into Team Builder (skipping any no longer in the legal pool).
    </p>
    <div class="gallery-grid" id="pro-team-gallery"></div>
  </section>

</main>
<footer>Pokémon Champions Competitive Data Platform · static dashboard built by pipelines/dashboard/</footer>

<script>window.DASHBOARD_DATA = {{ data_json | safe }};</script>
<script src="app.js"></script>
<script src="matchup.js"></script>
<script src="teams.js"></script>
</body>
</html>
